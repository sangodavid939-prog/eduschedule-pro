RewriteEngine On

RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=204,L]

RewriteRule ^api/auth(.*)$          api/auth.php          [L,QSA]
RewriteRule ^api/classes(.*)$       api/emploi_temps.php  [L,QSA]
RewriteRule ^api/enseignants(.*)$   api/emploi_temps.php  [L,QSA]
RewriteRule ^api/matieres(.*)$      api/emploi_temps.php  [L,QSA]
RewriteRule ^api/salles(.*)$        api/emploi_temps.php  [L,QSA]
RewriteRule ^api/emploi-temps(.*)$  api/emploi_temps.php  [L,QSA]
RewriteRule ^api/creneaux(.*)$      api/pointages.php     [L,QSA]
RewriteRule ^api/pointages(.*)$     api/pointages.php     [L,QSA]
RewriteRule ^api/cahiers(.*)$       api/cahiers.php       [L,QSA]
RewriteRule ^api/vacations(.*)$     api/vacations.php     [L,QSA]
RewriteRule ^api/dashboard(.*)$     api/vacations.php     [L,QSA]